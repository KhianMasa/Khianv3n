local function serverHop()
    task.spawn(function()
        local ok = pcall(function()
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
            local data = HttpService:JSONDecode(game:HttpGet(url))
            local servers = data and data.data or {}
            local pick
            for _, srv in ipairs(servers) do
                if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then pick = srv; break end
            end
            if pick then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer)
            else
                notify("No other servers found", "solar:danger-triangle-bold")
            end
        end)
        if not ok then notify("Server hop failed (API blocked)", "solar:danger-triangle-bold") end
    end)
end

