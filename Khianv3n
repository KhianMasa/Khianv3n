--==================================================================================
-- BACKGROUND LOOPS
--==================================================================================
task.spawn(function()
    while S.alive do
        pcall(function()
            -- status tag
            local color = Color3.fromRGB(0, 255, 160)
            local label = S.statusText
            if S.autoFarmMode == "TWEEN" then label = "Auto Run (Tween)"
            elseif S.autoFarmMode == "WARP" then label = "Auto Run (Teleport)"
            elseif S.statusText == "Running" then color = Color3.fromRGB(249, 115, 22)
            elseif S.statusText == "Searching" then color = Color3.fromRGB(59, 130, 246) end
            if StatusTag then
                if StatusTag.SetTitle then StatusTag:SetTitle("Status: " .. label) end
                if StatusTag.SetColor then StatusTag:SetColor(color) end
            end
            -- dashboard
            local mode = "Idle"
            if S.autoFarmMode == "TWEEN" then mode = "Auto Run (Tween)"
            elseif S.autoFarmMode == "WARP" then mode = "Auto Run (Teleport)" end
            if DashPara and DashPara.SetDesc then
                DashPara:SetDesc(string.format(
                    "Status: %s\nFarm Mode: %s\nCarried Eggs: %d\nFlight Speed: %d Studs/s\nFailed Eggs: %s",
                    S.statusText, mode, S.batchRunCount, S.glideSpeed,
                    S.skipFailedEggs and "Skipped (never delivered)" or "Collected"))
            end
        end)
        task.wait(0.5)
    end
end)

