local function isEggModel(obj)
    local n = string.lower(obj.Name)
    if string.find(n, "egg") then return true end
    local ok, rar = pcall(function() return obj:GetAttribute("Rarity") end)
    if ok and rar ~= nil then return true end
    return false
end

--[[
    isFailedEgg(obj)  —  robust "failed egg" detector.
    A failed egg is one that has already been used / hatched and did NOT succeed.
    Games flag this in different ways, so we check every common convention:
      * Attributes : Failed / IsFailed / Fail / HatchFailed / State / Status / Quality
      * Object name: contains "fail" / "broken"
      * Child values: BoolValue / StringValue named fail / state / status / quality
    When S.skipFailedEggs is ON these eggs are never collected nor delivered home.
]]
local FAIL_ATTRS = {
    "Failed", "IsFailed", "Fail", "HatchFailed", "IsFail", "FailedEgg",
    "State", "Status", "Quality", "Condition",
}

local function isFailedEgg(obj)
    -- 1) attributes
    for _, k in ipairs(FAIL_ATTRS) do
        local ok, v = pcall(function() return obj:GetAttribute(k) end)
        if ok and v ~= nil then
            if type(v) == "boolean" and v == true then return true end
            if type(v) == "string" then
                local lv = string.lower(v)
                if string.find(lv, "fail") or string.find(lv, "broken") or string.find(lv, "bad") then
                    return true
                end
            end
        end
    end
    -- 2) object name
    local n = string.lower(obj.Name)
    if string.find(n, "fail") or string.find(n, "broken") then return true end
    -- 3) child values
    local ok2, kids = pcall(function() return obj:GetChildren() end)
    if ok2 then
        for _, c in ipairs(kids) do
            local cn = string.lower(c.Name)
            if string.find(cn, "fail") or string.find(cn, "state")
                or string.find(cn, "status") or string.find(cn, "quality") then
                if c:IsA("BoolValue") and c.Value then return true end
                if c:IsA("StringValue") then
                    local lv = string.lower(c.Value)
                    if string.find(lv, "fail") or string.find(lv, "broken") or string.find(lv, "bad") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function collectEggs()
    local list = {}
    local ok = pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                if isEggModel(obj) then
                    -- SKIP FAILED EGGS: never target, carry, or deliver a failed egg
                    if S.skipFailedEggs and isFailedEgg(obj) then
                        -- intentionally ignored
                    else
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part then
                            table.insert(list, { obj = obj, part = part })
                        end
                    end
                end
            end
        end
    end)
    if not ok then return {} end
    return list
end

local function nearestEgg()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, e in ipairs(collectEggs()) do
        local d = (e.part.Position - hrp.Position).Magnitude
        if d < bestD then best, bestD = e, d end
    end
    return best
end

