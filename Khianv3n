local function firePromptsAround()
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled then
                local part = d.Parent
                local hrp = getHRP()
                if part and part:IsA("BasePart") and hrp then
                    if (part.Position - hrp.Position).Magnitude < 60 then
                        pcall(function() fireproximityprompt(d) end)
                    end
                end
            end
        end
    end)
end

local function startFarm(mode)
    if farmLoop then task.cancel(farmLoop); farmLoop = nil end
    S.autoFarmMode = mode
    if mode == "NONE" then return end
    farmLoop = task.spawn(function()
        while S.autoFarmMode == mode and S.alive do
            pcall(function()
                local egg = nearestEgg()
                local hrp = getHRP()
                if egg and hrp then
                    S.statusText = "Running"
                    if mode == "WARP" then
                        hrp.CFrame = CFrame.new(egg.part.Position + Vector3.new(0, 3, 0))
                    else
                        local tween = TweenService:Create(hrp, TweenInfo.new(
                            math.clamp((egg.part.Position - hrp.Position).Magnitude / math.max(S.glideSpeed, 1), 0.15, 2),
                            Enum.EasingStyle.Linear), { CFrame = CFrame.new(egg.part.Position + Vector3.new(0, 3, 0)) })
                        tween:Play()
                        tween.Completed:Wait()
                    end
                    firePromptsAround()
                    if Remotes.AskFieldEggCarry then
                        pcall(function() Remotes.AskFieldEggCarry:InvokeServer() end)
                    end
                    S.batchRunCount = S.batchRunCount + 1
                    if S.autoPlaceEvery5 and S.batchRunCount >= 5 then
                        S.batchRunCount = 0
                        if Remotes.AskPlaceEgg then pcall(function() Remotes.AskPlaceEgg:InvokeServer() end) end
                    end
                else
                    S.statusText = "Searching"
                    if S.autoTreadmill and Remotes.AskDon then
                        pcall(function() Remotes.AskDon:InvokeServer() end)
                    end
                end
            end)
            task.wait(mode == "WARP" and 0.15 or 0.4)
        end
        S.statusText = "Ready"
    end)
end

local function singleRun()
    task.spawn(function()
        local egg = nearestEgg()
        local hrp = getHRP()
        if egg and hrp then
            hrp.CFrame = CFrame.new(egg.part.Position + Vector3.new(0, 3, 0))
            task.wait(0.1)
            firePromptsAround()
            if Remotes.AskFieldEggCarry then pcall(function() Remotes.AskFieldEggCarry:InvokeServer() end) end
            notify("Single run complete", "solar:check-circle-bold")
        else
            notify(S.skipFailedEggs and "No valid egg found (failed eggs skipped)" or "No egg found nearby",
                "solar:danger-triangle-bold")
        end
    end)
end

local function placeEggs()
    task.spawn(function()
        -- FAILED EGGS ARE NEVER DELIVERED: collectEggs() already filters them out
        -- while S.skipFailedEggs is ON, so only good eggs ever reach the incubator.
        notify("Flying back to base to place eggs...", "solar:loader-bold")
        if Remotes.AskPlaceEgg then pcall(function() Remotes.AskPlaceEgg:InvokeServer() end) end
        firePromptsAround()
        if Remotes.AskHatch then pcall(function() Remotes.AskHatch:InvokeServer() end) end
        notify("Eggs placed and hatch requested!", "solar:check-circle-bold")
    end)
end

